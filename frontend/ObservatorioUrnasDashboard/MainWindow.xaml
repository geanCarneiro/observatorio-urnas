<Window x:Class="ObservatorioUrnasDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ObservatorioUrnasDashboard.UI"
        Title="Observatório das Urnas — Dashboard" Width="1440" Height="920"
        MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="210" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource CardBackground}"
                CornerRadius="10" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Observatório das Urnas" FontSize="25" FontWeight="Bold" Foreground="#1C2A3A" />
                    <TextBlock Text="Dashboard nativo · acompanhamento local do job mais recente"
                               Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding ConnectionText}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Width="280" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock Text="Progresso geral" FontWeight="SemiBold" Foreground="#24364A" />
                        <TextBlock Text="{Binding ProgressLabel}" DockPanel.Dock="Right" FontWeight="Bold"
                                   Margin="10,0,0,0" Foreground="{StaticResource AccentBrush}" />
                    </DockPanel>
                    <ProgressBar Height="13" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource CardBackground}"
                CornerRadius="10" Padding="14" Margin="0,0,12,12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Workers" FontSize="19" FontWeight="Bold" Foreground="#1C2A3A" />
                        <TextBlock Text="{Binding WorkerSummary}" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding RunTitle}" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding WorkerCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ui:WorkerCardPanel MinimumCardWidth="220" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1"
                                        CornerRadius="8" Padding="11" MinHeight="112">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="#24364A"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="12,0,0,0"
                                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" TextAlignment="Right"
                                                       ToolTip="{Binding Status}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Stage}" Margin="0,7,0,0"
                                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Stage}" />
                                        <TextBlock Grid.Row="2" Text="{Binding Section}" Margin="0,4,0,0"
                                                   Foreground="#47566A" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Section}" />
                                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,9,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProgressCaption}" Foreground="{StaticResource MutedBrush}"
                                                           ToolTip="{Binding ProgressCaption}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="12,0,0,0"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           TextAlignment="Right" ToolTip="{Binding ProgressText}" />
                                            </Grid>
                                            <ProgressBar Height="7" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                                         Value="{Binding Progress}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource CardBackground}"
                CornerRadius="10" Padding="14" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Atividade recente" FontSize="16" FontWeight="Bold"
                           Foreground="#1C2A3A" Margin="0,0,0,8" />
                <TextBox Text="{Binding ActivityText}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                         Background="#F7F9FC" Foreground="#35455A" FontFamily="Consolas" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Background="{StaticResource CardBackground}"
                CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock Text="Job mais recente" FontSize="19" FontWeight="Bold" Foreground="#1C2A3A" />
                <TextBlock Text="{Binding RunId}" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding RunStatus}" Margin="0,5,0,14" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <Button Content="Novo job" IsEnabled="{Binding CanCreateJob}" Click="NewJob_Click" />
                <Button Content="Histórico de execuções" Click="History_Click"
                        Background="#E6EBF2" Foreground="#24364A" />
                <Separator Margin="0,8,0,12" />
                <Button Content="Retomar execução" IsEnabled="{Binding CanResume}" Click="Resume_Click" />
                <Button Content="Solicitar parada segura" IsEnabled="{Binding CanStop}" Click="Stop_Click"
                        Background="#A63838" />
                <Separator Margin="0,8,0,12" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           MinHeight="54" />
                <Button Content="Abrir interface completa no navegador" Click="OpenBrowser_Click"
                        Background="#E6EBF2" Foreground="#24364A" Margin="0,8,0,0" />
                <TextBlock Text="A interface completa mantém prévia, criação de jobs, detalhes e demais comandos."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
