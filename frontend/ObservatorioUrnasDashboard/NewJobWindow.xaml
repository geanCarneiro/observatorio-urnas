<Window x:Class="ObservatorioUrnasDashboard.NewJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo job" Width="760" Height="820" MinWidth="680" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackground}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Novo job" FontSize="23" FontWeight="Bold" Foreground="#1C2A3A" />
            <TextBlock Text="Defina os parâmetros, confira a prévia e inicie quando estiver pronto."
                       Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource CardBackground}" CornerRadius="9" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Operação" FontWeight="Bold" Foreground="#24364A" />
                        <ComboBox x:Name="ModeSelector" SelectedValuePath="Tag" SelectedValue="collect"
                                  SelectionChanged="Mode_SelectionChanged" Margin="0,8,0,0">
                            <ComboBoxItem Content="Coleta incremental / atualização bruta" Tag="collect" />
                            <ComboBoxItem Content="Coleta e conciliação completa por remessas" Tag="batch_process" />
                            <ComboBoxItem Content="Reprocessar dados locais" Tag="reprocess" />
                        </ComboBox>
                        <TextBlock x:Name="ModeDescription" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="SelectionPanel" Background="{StaticResource CardBackground}" CornerRadius="9"
                        Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Abrangência" FontWeight="Bold" Foreground="#24364A" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Turno" />
                                <ComboBox x:Name="TurnSelector" SelectedValuePath="Tag" SelectedValue="2"
                                          SelectionChanged="Selection_Changed">
                                    <ComboBoxItem Content="2º turno" Tag="2" />
                                    <ComboBoxItem Content="1º turno" Tag="1" />
                                    <ComboBoxItem Content="Ambos os turnos" Tag="ambos" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="UF (vazio = todas)" />
                                <TextBox x:Name="UfBox" TextChanged="Selection_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Município · código TSE" />
                                <TextBox x:Name="MunicipioBox" TextChanged="Selection_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Zona" />
                                <TextBox x:Name="ZonaBox" TextChanged="Selection_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="Seção" />
                                <TextBox x:Name="SecaoBox" TextChanged="Selection_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Offset de seções" />
                                <TextBox x:Name="OffsetBox" Text="0" TextChanged="Selection_Changed" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="CollectionOptions">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Máximo de seções (vazio = sem limite)" />
                                <TextBox x:Name="LimitBox" TextChanged="Selection_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Processos worker (1–61 no Windows)" />
                                <TextBox x:Name="WorkersBox" Text="15" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="IncrementalBox" Content="Modo incremental · ignorar seções já existentes"
                                  IsChecked="True" Margin="0,10,0,0" />
                        <StackPanel x:Name="BatchOptions" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Text="Seções por remessa" />
                            <TextBox x:Name="BatchSizeBox" Text="500" />
                        </StackPanel>
                        <StackPanel x:Name="ReprocessOptions" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Text="Raiz local de dados (opcional)" />
                            <TextBox x:Name="DataRootBox" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackground}" CornerRadius="9" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Prévia" FontWeight="Bold" Foreground="#24364A" />
                        <TextBlock x:Name="PreviewText" Text="A prévia ainda não foi calculada."
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <ProgressBar x:Name="PreviewProgress" Height="8" IsIndeterminate="True"
                                     Visibility="Collapsed" Margin="0,8,0,0" />
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#A83131"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="Cancelar" Click="Cancel_Click" DockPanel.Dock="Right"
                    Background="#E6EBF2" Foreground="#24364A" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PreviewButton" Content="Calcular prévia" Click="Preview_Click" />
                <Button x:Name="StartButton" Content="Iniciar job" Click="Start_Click"
                        Margin="8,0,0,8" IsEnabled="False" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
